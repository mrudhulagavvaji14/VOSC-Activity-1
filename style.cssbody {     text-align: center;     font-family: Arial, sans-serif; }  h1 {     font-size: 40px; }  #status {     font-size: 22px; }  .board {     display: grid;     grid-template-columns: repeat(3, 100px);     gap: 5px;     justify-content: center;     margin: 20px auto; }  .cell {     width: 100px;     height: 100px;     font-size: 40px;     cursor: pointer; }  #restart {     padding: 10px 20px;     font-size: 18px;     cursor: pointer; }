body {
    text-align: center;
    font-family: Arial, sans-serif;
}

h1 {
    font-size: 40px;
}

#status {
    font-size: 22px;
}

.board {
    display: grid;
    grid-template-columns: repeat(3, 100px);
    gap: 5px;
    justify-content: center;
    margin: 20px auto;
}

.cell {
    width: 100px;
    height: 100px;
    font-size: 40px;
    cursor: pointer;
}

#restart {
    padding: 10px 20px;
    font-size: 18px;
    cursor: pointer;
}
